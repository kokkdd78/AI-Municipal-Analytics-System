# Pooled Neon URL used only by the server-side application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

# Direct Neon URL used by Prisma CLI migrations and production seeding.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Direct URL for a separate Neon test branch. Never point this at production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_BRANCH_HOST/DATABASE?sslmode=require"

# Better Auth server secret. Generate a high-entropy value for each environment.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Exact public application origin used by Better Auth.
BETTER_AUTH_URL="https://YOUR_APP_ORIGIN"

# Comma-separated exact origins allowed to make authenticated requests.
BETTER_AUTH_TRUSTED_ORIGINS="https://YOUR_APP_ORIGIN"

# Required for non-Vercel production: exact IPs/CIDRs of reverse proxies allowed to append forwarded client IPs.
# Direct Vercel deployments must leave this blank and keep Vercel system environment variables enabled;
# Vercel sets VERCEL=1 and overwrites x-forwarded-for with one validated client IP.
AUTH_TRUSTED_PROXY_CIDRS="YOUR_PROXY_IP_OR_CIDR,YOUR_SECOND_PROXY_IP_OR_CIDR"

# Server-only Cloudinary credentials for report image upload.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# Optional server-only Gemini report-assistance configuration. Leave both blank to keep manual reporting only.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional, test-branch-only credential provisioning. The command refuses production URLs.
TEST_CITIZEN_PHONE="+COUNTRY_CODE_AND_NUMBER"
TEST_CITIZEN_PASSWORD="REPLACE_WITH_A_TEST_PASSWORD"
TEST_MANAGER_PASSWORD="REPLACE_WITH_A_TEST_PASSWORD"
TEST_CREW_PASSWORD="REPLACE_WITH_A_TEST_PASSWORD"
